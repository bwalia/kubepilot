# ─────────────────────────────────────────────────────────────────────────────
# KubePilot — systemd environment file
#
# Copy to /etc/kubepilot/kubepilot.env, customize, and lock down:
#   sudo install -D -m 600 deploy/systemd/kubepilot.env.example /etc/kubepilot/kubepilot.env
#
# This file contains secrets — keep it mode 0600 and out of version control.
# Every line is a viper key with the KUBEPILOT_ prefix; see config.example.yaml
# for the complete list of settings. Values here override the built-in defaults.
# ─────────────────────────────────────────────────────────────────────────────

# Path to the kubeconfig KubePilot uses to reach the cluster.
KUBEPILOT_KUBECONFIG=/etc/kubepilot/kubeconfig.yaml

# ── Dashboard / API authentication ───────────────────────────────────────────
# Enabled by default. When on, every dashboard + API route (except /healthz,
# used by liveness probes) requires credentials. The browser presents its native
# sign-in dialog over a blank page; once the credentials match, the dashboard
# loads. Provide Basic auth (username + password) and/or a Bearer token — if
# auth is enabled with neither, the server refuses to start.
KUBEPILOT_DASHBOARD_AUTH_ENABLED=true
KUBEPILOT_DASHBOARD_AUTH_USERNAME=admin
# CHANGE THIS before exposing the dashboard to any network.
KUBEPILOT_DASHBOARD_AUTH_PASSWORD=change-me
# Optional Bearer token for programmatic/API clients (leave blank to disable):
#KUBEPILOT_DASHBOARD_AUTH_TOKEN=

# ── Ollama (AI backend) ──────────────────────────────────────────────────────
KUBEPILOT_OLLAMA_BASE_URL=http://localhost:11434/v1
KUBEPILOT_OLLAMA_MODEL=llama3

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to the dashboard's public origin when serving behind a domain/proxy.
KUBEPILOT_CORS_ALLOWED_ORIGINS=https://kubepilot.example.com

# ── Mutation endpoints (secure default: disabled) ────────────────────────────
# enable_action_mutations is required for the dashboard's port-forward feature.
KUBEPILOT_ENABLE_KUBECONFIG_MUTATIONS=false
KUBEPILOT_ENABLE_ACTION_MUTATIONS=false

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# Leave the endpoint empty and KubePilot opens no outbound telemetry connection:
# tracing is a no-op and metrics stay local to /metrics. Point it at a collector
# to ship traces and metrics out.
#KUBEPILOT_OTEL_ENDPOINT=otel-collector.lan:4317
#KUBEPILOT_OTEL_PROTOCOL=grpc
#KUBEPILOT_OTEL_INSECURE=true
# Names this host in a shared backend, e.g. int | test | prod.
#KUBEPILOT_OTEL_ENVIRONMENT=int
#KUBEPILOT_OTEL_SERVICE_NAMESPACE=home-lab
# Head-sampling probability for root spans (0.0-1.0).
#KUBEPILOT_OTEL_SAMPLE_RATIO=1.0

# ── Prometheus ───────────────────────────────────────────────────────────────
# Serves /metrics on the dashboard port. Works with no collector anywhere.
# The endpoint is exempt from dashboard auth by default (scrapers expect that);
# its labels carry no namespace, pod, or object names. Set the second variable
# to close it behind the dashboard credentials anyway.
KUBEPILOT_METRICS_ENABLED=true
KUBEPILOT_METRICS_REQUIRE_AUTH=false
