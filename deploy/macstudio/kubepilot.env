# KubePilot — Mac Studio (launchd) runtime config
#
# Installed to ~/.kubepilot/kubepilot.env on every Mac Studio deploy.
# This file is the source of truth for interactive LLM + serve defaults.
# Secrets (password, kubeconfig path overrides) live in secrets.env (not in git).
#
# Override the model for a one-off experiment via launchd env or secrets.env;
# the next deploy will re-apply this file and restore the pinned model.

# ── Ollama (interactive dashboard RCA) ───────────────────────────────────────
# Small non-thinking model with num_ctx=4096 (see Modelfile.llama3.2-3b-dash).
# Do NOT pin large thinking models (qwen3.8, qwen3-coder:30b, etc.) here —
# they routinely exceed UI timeouts and queue behind every dashboard click.
# KubePilot's OWN Ollama (com.ollama.kubepilot, :11438, installed by install-runtime.sh). The Ollama on :11434 serves
# OpsAPI on every environment: KubePilot's 1-3 minute requests there left it without a turn and its assistant timed
# out everywhere. Never point KubePilot back at :11434.
KUBEPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11438/v1
KUBEPILOT_OLLAMA_MODEL=llama3.2:3b-dash

# ── Dashboard / API ──────────────────────────────────────────────────────────
KUBEPILOT_DASHBOARD_AUTH_ENABLED=true
KUBEPILOT_DASHBOARD_AUTH_USERNAME=admin
KUBEPILOT_CORS_ALLOWED_ORIGINS=http://localhost:8383,http://127.0.0.1:8383,http://192.168.1.177:8383
KUBEPILOT_ENABLE_KUBECONFIG_MUTATIONS=true
KUBEPILOT_ENABLE_ACTION_MUTATIONS=false

# ── Telemetry identity (local metrics on :8383/metrics; no OTLP export) ──────
KUBEPILOT_OTEL_ENVIRONMENT=macstudio
KUBEPILOT_OTEL_SERVICE_NAMESPACE=home-lab
KUBEPILOT_METRICS_ENABLED=true
