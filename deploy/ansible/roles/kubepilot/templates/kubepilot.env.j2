# Managed by Ansible (deploy/ansible/roles/kubepilot) — do not edit by hand.
# Rendered for {{ inventory_hostname }}. Every key is a viper KUBEPILOT_ setting.

KUBEPILOT_KUBECONFIG={{ kubepilot_kubeconfig_path }}

# ── Dashboard / API authentication (enabled by default) ──────────────────────
KUBEPILOT_DASHBOARD_AUTH_ENABLED=true
KUBEPILOT_DASHBOARD_AUTH_USERNAME={{ kubepilot_auth_username }}
KUBEPILOT_DASHBOARD_AUTH_PASSWORD={{ kubepilot_auth_password }}
{% if kubepilot_auth_token %}
KUBEPILOT_DASHBOARD_AUTH_TOKEN={{ kubepilot_auth_token }}
{% endif %}

# ── Ollama (AI backend) ──────────────────────────────────────────────────────
KUBEPILOT_OLLAMA_BASE_URL={{ kubepilot_ollama_base_url }}
KUBEPILOT_OLLAMA_MODEL={{ kubepilot_ollama_model }}

{% if kubepilot_cors_allowed_origins %}
# ── CORS ─────────────────────────────────────────────────────────────────────
KUBEPILOT_CORS_ALLOWED_ORIGINS={{ kubepilot_cors_allowed_origins }}
{% endif %}

# ── Mutation endpoints (secure default: disabled) ────────────────────────────
KUBEPILOT_ENABLE_KUBECONFIG_MUTATIONS=false
KUBEPILOT_ENABLE_ACTION_MUTATIONS=false
