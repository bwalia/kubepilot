# Runtime-only image built from host-prebuilt artifacts.
# Avoids in-container Go/npm fetches that fail behind a corporate TLS-inspecting proxy.
# Prereqs (run on host):
#   cd dashboard && npm ci && npm run build
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o dist/kubepilot-linux-arm64 ./cmd/kubepilot
FROM gcr.io/distroless/static:nonroot

# Server serves the dashboard from the relative path ./dashboard/out, so the
# working directory must be / where that directory is copied.
WORKDIR /

COPY dist/kubepilot-linux-arm64 /kubepilot
COPY dashboard/out /dashboard/out

USER nonroot:nonroot
EXPOSE 8383 9090
ENTRYPOINT ["/kubepilot", "serve"]
