app_identifier("io.kubepilot.app")
# Pricing is set via scripts/ensure_free_worldwide.rb (new ASC price-schedule
# API). Do not set price_tier here — deliver's legacy upload_price_tier 400s.
# Release automatically once Apple approves.
automatic_release(true)
phased_release(false)
submit_for_review(true)
force(true)
precheck_include_in_app_purchases(false)
# Routing coverage is uploaded by scripts/ensure_routing_coverage.rb (worldwide
# MultiPolygon at metadata/routing_app_coverage.geojson).
#
# Sign-in is required for review — ASC "Sign-in required" needs demo_user /
# demo_password (also mirrored in metadata/review_information/*.txt).
app_review_information(
  first_name: "KubePilot Demo",
  last_name: "Team",
  phone_number: "+44 20 7946 0958",
  email_address: "support@kubepilot.org",
  demo_user: "apple",
  demo_password: "review"
)
submission_information({
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false,
  export_compliance_encryption_updated: false,
  content_rights_contains_third_party_content: false,
  content_rights_has_rights: true
})
